{
  "name": "evalculist",
  "version": "1.0.1",
  "description": "Safe evaluation of JavaScript expressions with controlled variable access",
  "author": "Dan Allison <dan@calculist.io>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./safe": {
      "import": {
        "types": "./dist/safe.d.ts",
        "default": "./dist/safe.js"
      },
      "require": {
        "types": "./dist/safe.d.cts",
        "default": "./dist/safe.cjs"
      }
    }
  },
  "browser": "./dist/index.global.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/calculist/evalculist.git"
  },
  "keywords": [
    "eval",
    "expression",
    "sandbox",
    "safe",
    "parser",
    "interpreter"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.2"
  }
}
